{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://yourorg.dev/protocol/v0/turn_response.schema.json",
    "title": "TurnResponse",
    "type": "object",
    "required": ["conversationId", "messages"],
    "properties": {
        "conversationId": { "type": "string", "minLength": 1 },
        "messages": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "assistant_message.schema.json" }
        },
        "ui": { "$ref": "ui_frame.schema.json" }
    },
    "additionalProperties": false
}
