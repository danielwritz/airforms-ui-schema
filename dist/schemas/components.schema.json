{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://yourorg.dev/protocol/v0/components.schema.json",
    "title": "Component",
    "oneOf": [
        { "$ref": "#/$defs/textComponent" },
        { "$ref": "#/$defs/textareaComponent" },
        { "$ref": "#/$defs/numberComponent" },
        { "$ref": "#/$defs/dateComponent" },
        { "$ref": "#/$defs/selectComponent" },
        { "$ref": "#/$defs/sliderComponent" },
        { "$ref": "#/$defs/mapPinComponent" },
        { "$ref": "#/$defs/reviewComponent" }
    ],
    "$defs": {
        "textComponent": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "text" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
            },
            "additionalProperties": false
        },
        "textareaComponent": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "textarea" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
            },
            "additionalProperties": false
        },
        "numberComponent": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "number" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
            },
            "additionalProperties": false
        },
        "dateComponent": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "date" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
            },
            "additionalProperties": false
        },
        "selectComponent": {
            "type": "object",
            "required": ["id", "type", "label", "options"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "select" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "options": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "properties": {
                            "label": { "type": "string", "minLength": 1 },
                            "value": { "type": "string", "minLength": 1 }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "sliderComponent": {
            "type": "object",
            "required": ["id", "type", "label", "min", "max", "step"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "slider" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
        },
        "mapPinComponent": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "map_pin" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
            },
            "additionalProperties": false
        },
        "reviewComponent": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "review" },
                "label": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "source": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
        }
    }
}
