{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://yourorg.dev/protocol/v0/ui_frame.schema.json",
    "title": "UiFrame",
    "type": "object",
    "required": ["type", "version", "frameId", "title", "state", "components", "primaryAction"],
    "properties": {
        "type": { "const": "ui_frame" },
        "version": { "const": "1.0" },
        "frameId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "state": {
            "type": "object",
            "required": ["values"],
            "properties": {
                "values": { "type": "object" }
            },
            "additionalProperties": false
        },
        "components": {
            "type": "array",
            "items": { "$ref": "components.schema.json" }
        },
        "primaryAction": { "$ref": "actions.schema.json" }
    },
    "additionalProperties": false
}
